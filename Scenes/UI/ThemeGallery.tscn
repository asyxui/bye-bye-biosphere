[gd_scene format=3]

[node name="ThemeGallery" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.05, 0.06, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 32.0
offset_right = -32.0
offset_bottom = -32.0

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"DisplayTitle"
text = "THEME DIAGNOSTICS"

[node name="Description" type="Label" parent="Margin/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"Body"
text = "Typography, interaction states, diagnostic surfaces, slots, and status roles."

[node name="Panel" type="PanelContainer" parent="Margin/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"ModalPanel"

[node name="Content" type="VBoxContainer" parent="Margin/Scroll/Rows/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Section" type="Label" parent="Margin/Scroll/Rows/Panel/Content"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "CONTROLS / FOCUS / DISABLED"

[node name="Actions" type="HBoxContainer" parent="Margin/Scroll/Rows/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Primary" type="Button" parent="Margin/Scroll/Rows/Panel/Content/Actions"]
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Apply"

[node name="Secondary" type="Button" parent="Margin/Scroll/Rows/Panel/Content/Actions"]
layout_mode = 2
theme_type_variation = &"SecondaryButton"
text = "Cancel"

[node name="Destructive" type="Button" parent="Margin/Scroll/Rows/Panel/Content/Actions"]
layout_mode = 2
theme_type_variation = &"DestructiveButton"
text = "Purge"

[node name="Disabled" type="Button" parent="Margin/Scroll/Rows/Panel/Content/Actions"]
layout_mode = 2
disabled = true
text = "Disabled"

[node name="Options" type="HBoxContainer" parent="Margin/Scroll/Rows/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CheckBox" type="CheckBox" parent="Margin/Scroll/Rows/Panel/Content/Options"]
layout_mode = 2
button_pressed = true
text = "Telemetry enabled"

[node name="OptionButton" type="OptionButton" parent="Margin/Scroll/Rows/Panel/Content/Options"]
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Standard"
popup/item_0/id = 0
popup/item_1/text = "Diagnostic"
popup/item_1/id = 1

[node name="LineEdit" type="LineEdit" parent="Margin/Scroll/Rows/Panel/Content/Options"]
layout_mode = 2
placeholder_text = "Search records"

[node name="Slider" type="HSlider" parent="Margin/Scroll/Rows/Panel/Content"]
custom_minimum_size = Vector2(360, 24)
layout_mode = 2
value = 62.0

[node name="Progress" type="ProgressBar" parent="Margin/Scroll/Rows/Panel/Content"]
layout_mode = 2
value = 64.0
show_percentage = false

[node name="Slots" type="HBoxContainer" parent="Margin/Scroll/Rows/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Normal" type="PanelContainer" parent="Margin/Scroll/Rows/Panel/Content/Slots"]
custom_minimum_size = Vector2(80, 80)
layout_mode = 2
theme_type_variation = &"InventorySlot"

[node name="Selected" type="PanelContainer" parent="Margin/Scroll/Rows/Panel/Content/Slots"]
custom_minimum_size = Vector2(80, 80)
layout_mode = 2
theme_type_variation = &"InventorySlotSelected"

[node name="Drag" type="PanelContainer" parent="Margin/Scroll/Rows/Panel/Content/Slots"]
custom_minimum_size = Vector2(80, 80)
layout_mode = 2
theme_type_variation = &"InventorySlotDragSource"

[node name="Drop" type="PanelContainer" parent="Margin/Scroll/Rows/Panel/Content/Slots"]
custom_minimum_size = Vector2(80, 80)
layout_mode = 2
theme_type_variation = &"InventorySlotDropTarget"

[node name="Status" type="HBoxContainer" parent="Margin/Scroll/Rows/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Success" type="Label" parent="Margin/Scroll/Rows/Panel/Content/Status"]
layout_mode = 2
theme_type_variation = &"StatusSuccess"
text = "SYSTEM READY"

[node name="Warning" type="Label" parent="Margin/Scroll/Rows/Panel/Content/Status"]
layout_mode = 2
theme_type_variation = &"StatusWarning"
text = "CAUTION"

[node name="Error" type="Label" parent="Margin/Scroll/Rows/Panel/Content/Status"]
layout_mode = 2
theme_type_variation = &"StatusError"
text = "FAULT"
